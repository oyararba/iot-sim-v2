-- Agriculture IoTDL Rules
--
-- Only sensor_reading enters the stream (agriculture.sql), so every rule
-- reads sensor_reading and names the measure it is about in the
-- measure_type position:
--     sensor_reading(device_id, measure_type, value, value2, value3, depth_cm)
-- Trailing arguments may be left out. Window sizes and fire times take a
-- unit; a bare number in a sliding window is a count of readings.

new metric_avg[sliding(s, 6)](device_id, Moisture, (avg_value = avg(value))) @ (s + 7) :-
    sensor_reading(device_id, MOISTURE, value) @ z;

new metric_avg[sliding(s, 6)](device_id, AirTemp, (avg_value = avg(value))) @ (s + 7) :-
    sensor_reading(device_id, AIR_TEMP, value) @ z;

new alert[tumbling(s, 30 MIN)](device_id, DROUGHT_STRESS, (value = avg(value))) @ (s + 31 MIN) :-
    sensor_reading(device_id, MOISTURE, value) @ z,
    value < 25;

new alert[tumbling(s, 60 MIN)](device_id, HEATWAVE, (value = avg(value))) @ (s + 61 MIN) :-
    sensor_reading(device_id, AIR_TEMP, value) @ z,
    value > 38;

new alert[tumbling(s, 60 MIN)](device_id, FROST_RISK, (value = avg(value))) @ (s + 61 MIN) :-
    sensor_reading(device_id, AIR_TEMP, value) @ z,
    value < 3;

new report[tumbling(s, 60 MIN)](device_id, IRRIGATION_NEEDED) @ (s + 61 MIN) :-
    alert(device_id, DROUGHT_STRESS, value) @ z,
    value < 25;
